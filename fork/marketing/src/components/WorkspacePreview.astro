      <div class="workspace-main">
        <div class="workspace-top"><div><span>little-garden /</span> <strong>A better welcome</strong></div><button type="button" class="preview-dock-toggle" aria-expanded="true" aria-controls="preview-dock">Changes <span>+24 −8</span></button></div>
        <div class="workspace-content">
