---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL, REPO_URL } from "../lib/releases";
---

<Layout title="Download Trellis" description="Find Trellis for macOS, Windows, or Linux. A local-first workspace for your coding agents.">
  <section class="hero shell download-hero">
    <p class="eyebrow"><span></span> Make yourself at home.</p>
    <h1>Your next idea.<br /><em>Your kind of machine.</em></h1>
    <p class="hero-description">A little room for your coding agents.<br />Choose a download to get started.</p>
    <p class="fine" data-release-status aria-live="polite">Finding the latest release…</p>
  </section>
  <section class="shell downloads" aria-label="Download Trellis">
    <div class="download-grid" data-download-grid>
      <a class="download-card" href={RELEASES_URL} data-release-platform="mac-arm64"><span>macOS</span><strong>Apple Silicon</strong><small>M-series Macs <span aria-hidden="true">↗</span></small></a>
      <a class="download-card" href={RELEASES_URL} data-release-platform="mac-x64"><span>macOS</span><strong>Intel</strong><small>Intel-based Macs <span aria-hidden="true">↗</span></small></a>
      <a class="download-card" href={RELEASES_URL} data-release-platform="windows-x64"><span>Windows</span><strong>x64 installer</strong><small>Windows 10 & 11 <span aria-hidden="true">↗</span></small></a>
      <a class="download-card" href={RELEASES_URL} data-release-platform="linux-x64"><span>Linux</span><strong>x64 AppImage</strong><small>Your Linux desktop <span aria-hidden="true">↗</span></small></a>
    </div>
    <p class="download-note">Some releases are unsigned. macOS may block apps that are not notarized; Windows may show SmartScreen warnings. Check the release notes and artifact provenance before installing.</p>
    <p class="download-note">Install a supported provider CLI and sign in before your first thread.<br /><a href={`${REPO_URL}/blob/main/docs/user/getting-started.md`}>Read the getting started guide ↗</a></p>
    <div class="download-links"><a href={RELEASES_URL}>All releases ↗</a><a href={`${REPO_URL}/blob/main/docs/maintainers/development.md`}>Build from source ↗</a></div>
  </section>
</Layout>

<script>
  import {
    RELEASES_URL,
    fetchLatestRelease,
    findReleaseAsset,
    type ReleasePlatform,
  } from "../lib/releases";

  const releaseStatus = document.querySelector<HTMLElement>("[data-release-status]");
  const downloadCards = document.querySelectorAll<HTMLAnchorElement>("[data-release-platform]");

  if (downloadCards.length > 0) {
    void hydrateDownloadCards();
  }

  async function hydrateDownloadCards(): Promise<void> {
    try {
      const release = await fetchLatestRelease();
      if (releaseStatus) {
        releaseStatus.textContent = release.tag_name
          ? `Latest release: ${release.tag_name}`
          : "Latest release";
      }

      for (const card of downloadCards) {
        const platform = card.dataset.releasePlatform;
        if (!isReleasePlatform(platform)) {
          card.href = release.html_url || RELEASES_URL;
          continue;
        }

        const asset = findReleaseAsset(release, platform);
        card.href = asset?.browser_download_url ?? release.html_url ?? RELEASES_URL;
        card.dataset.releaseReady = asset ? "true" : "false";
      }
    } catch {
      if (releaseStatus) {
        releaseStatus.textContent = "Could not load latest release. Showing release page links.";
      }
      for (const card of downloadCards) {
        card.href = RELEASES_URL;
        card.dataset.releaseReady = "false";
      }
    }
  }

  function isReleasePlatform(value: string | undefined): value is ReleasePlatform {
    return (
      value === "mac-arm64" ||
      value === "mac-x64" ||
      value === "windows-x64" ||
      value === "linux-x64"
    );
  }
</script>
