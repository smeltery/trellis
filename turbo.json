{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "TRELLIS_HOME",
    "TRELLIS_DESKTOP_WS_URL",
    "TRELLIS_BROWSER_HOST_PIPE_PATH",
    "TRELLIS_BROWSER_USE_PIPE_PATH",
    "TRELLIS_BROWSER_PERF",
    "TRELLIS_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "TRELLIS_GROK_ACP_DEBUG",
    "TRELLIS_WEB_SOURCEMAP",
    "TRELLIS_DEV_REACT_COMPILER",
    "TRELLIS_SERVER_SOURCEMAP",
    "TRELLIS_DESKTOP_SOURCEMAP",
    "TRELLIS_MODE",
    "TRELLIS_PORT",
    "TRELLIS_NO_BROWSER",
    "TRELLIS_AUTH_TOKEN",
    "TRELLIS_PUBLIC_URL",
    "TRELLIS_ALLOW_INSECURE_REMOTE",
    "TRELLIS_LOG_WS_EVENTS",
    "TRELLIS_HOST",
    "TRELLIS_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "typecheck:native": {
      "dependsOn": ["^typecheck:native"],
      "outputs": [],
      "cache": false
    },
    "typecheck:legacy": {
      "dependsOn": ["^typecheck:legacy"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
